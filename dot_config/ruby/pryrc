#!/usr/bin/ruby

# No Pry.editor here: pry falls back to $EDITOR.
Pry.config.history_file = "#{ENV['XDG_STATE_HOME']}/ruby/pry_history"

# Pretty printing, when awesome_print or amazing_print is installed
begin
  require 'awesome_print'
  AwesomePrint.pry!
rescue LoadError
  begin
    require 'amazing_print'
    AmazingPrint.pry!
  rescue LoadError
  end
end

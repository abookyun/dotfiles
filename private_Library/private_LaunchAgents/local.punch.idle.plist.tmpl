<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.punch.idle</string>

	<!-- Runs `punch idle-check` on a timer. The check itself is a no-op unless
	     something is being tracked, so the common case costs one timew read.

	     Absolute paths throughout: launchd gives an agent almost no environment,
	     and ~/.local/bin only lands on PATH via .zshrc, which this never reads.
	     TIMEWARRIORDB is passed explicitly for the same reason -- inheriting a
	     missing one would quietly write to a second, empty database. -->
	<key>ProgramArguments</key>
	<array>
		<string>{{ .chezmoi.homeDir }}/.local/bin/punch</string>
		<string>idle-check</string>
	</array>

	<key>EnvironmentVariables</key>
	<dict>
		<key>TIMEWARRIORDB</key>
		<string>{{ .chezmoi.homeDir }}/.local/share/timewarrior</string>
		<key>XDG_CONFIG_HOME</key>
		<string>{{ .chezmoi.homeDir }}/.config</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>

	<!-- A minute is fine granularity for a fifteen-minute threshold, and keeps
	     the worst-case overshoot to a minute. -->
	<key>StartInterval</key>
	<integer>60</integer>

	<!-- Do not fire a burst of catch-up runs after the machine wakes; the idle
	     probe already reports the true gap. -->
	<key>RunAtLoad</key>
	<false/>

	<key>StandardOutPath</key>
	<string>{{ .chezmoi.homeDir }}/.local/state/punch/idle.log</string>
	<key>StandardErrorPath</key>
	<string>{{ .chezmoi.homeDir }}/.local/state/punch/idle.log</string>

	<key>ProcessType</key>
	<string>Background</string>
	<key>LowPriorityIO</key>
	<true/>
</dict>
</plist>

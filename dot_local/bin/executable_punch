#!/usr/bin/env zsh
# punch -- a thin wrapper around timewarrior, shaped like a punch clock.
#
# timewarrior already models time the way I work: one timeline, one active
# interval, punching in somewhere punches you out of everywhere else. What it
# lacks is knowing *which* project a directory belongs to, and what an hour of
# it is worth. That is all this adds.
#
# Everything here degrades to plain timewarrior: `punch` with an unknown
# command forwards to `timew`, so nothing is locked away behind the wrapper.

emulate -L zsh
setopt extended_glob
set -o pipefail

readonly PUNCH_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/punch/config"

# --- config -----------------------------------------------------------------

# Precedence, weakest first: built-in defaults, then the config file, then the
# environment. Defaults exist so punch still runs with no config file at all;
# the environment wins last so a single run can be overridden without editing
# config -- which is also what makes the idle logic testable.
typeset -A _punch_env_overrides
typeset _punch_setting
for _punch_setting in PUNCH_IDLE_MINUTES PUNCH_MAX_INTERVAL_HOURS \
                      PUNCH_IGNORE_PATHS PUNCH_CURRENCY \
                      PUNCH_TMUX_ENABLED PUNCH_IDLE_ENABLED \
                      PUNCH_HINT_ENABLED PUNCH_TITLE_ENABLED; do
  [[ -n ${(P)_punch_setting} ]] && _punch_env_overrides[$_punch_setting]=${(P)_punch_setting}
done

typeset -g PUNCH_IDLE_MINUTES=15
typeset -g PUNCH_MAX_INTERVAL_HOURS=12
typeset -g PUNCH_IGNORE_PATHS=""
typeset -g PUNCH_CURRENCY="TWD"
typeset -g PUNCH_TMUX_ENABLED=1
typeset -g PUNCH_IDLE_ENABLED=1

[[ -r $PUNCH_CONFIG ]] && source $PUNCH_CONFIG

# Rates live outside version control. The config file above is a symlink into
# the dotfiles repo; hourly rates are not something to commit.
#
# The file may set either PUNCH_RATE_<NAME>=n for ASCII project names, or
# punch_rate[<tag>]=n for any name at all.
readonly PUNCH_RATES_FILE="${PUNCH_CONFIG:h}/rates"
typeset -gA punch_rate
[[ -r $PUNCH_RATES_FILE ]] && source $PUNCH_RATES_FILE

for _punch_setting in ${(k)_punch_env_overrides}; do
  typeset -g $_punch_setting=${_punch_env_overrides[$_punch_setting]}
done
unset _punch_env_overrides _punch_setting

# --- project identity -------------------------------------------------------

# Resolve the project for a directory, in order of how deliberate the signal is:
# an explicit .punch-card file beats a git remote, which beats the directory
# name. Prints nothing when the directory is ignored or has no identity.
punch_project_for() {
  local dir=${1:-$PWD}
  [[ -d $dir ]] || return 1

  local resolved=${dir:A}

  local ignored
  for ignored in ${(s.:.)PUNCH_IGNORE_PATHS}; do
    [[ -n $ignored ]] || continue
    local expanded=${~ignored}
    [[ $resolved == ${expanded:A}(|/*) ]] && return 1
  done

  # An explicit marker anywhere up the tree wins.
  local probe=$resolved
  while [[ -n $probe && $probe != / ]]; do
    if [[ -r $probe/.punch-card ]]; then
      local name
      # Ignore blank lines and comments so the file can explain itself.
      name=$(grep -v -e '^[[:space:]]*$' -e '^[[:space:]]*#' $probe/.punch-card 2>/dev/null | head -1)
      name=${name##[[:space:]]#}
      name=${name%%[[:space:]]#}
      if [[ -n $name ]]; then
        print -r -- $(punch_slug $name)
        return 0
      fi
    fi
    probe=${probe:h}
  done

  # Otherwise fall back to the git repository this directory belongs to.
  local toplevel
  toplevel=$(git -C $resolved rev-parse --show-toplevel 2>/dev/null)
  if [[ -n $toplevel ]]; then
    local remote
    remote=$(git -C $resolved remote get-url origin 2>/dev/null)
    if [[ -n $remote ]]; then
      remote=${remote%.git}
      print -r -- $(punch_slug ${remote:t})
      return 0
    fi
    print -r -- $(punch_slug ${toplevel:t})
    return 0
  fi

  return 1
}

# Normalise a name into a tag that survives shells, reports and filenames.
# Non-ASCII is kept as-is: project names are often Chinese, and mangling them
# into dashes would make every such project collide under the same tag.
punch_slug() {
  local raw=${1//[[:space:]]##/-}
  # Strip only what actually breaks tags: shell metacharacters and separators.
  raw=${raw//[\'\"\`\$\\\;\&\|\<\>\(\)\[\]\{\}\*\?\!\#\%\,\:\/]/-}
  # Collapse runs of dashes, then trim them from both ends.
  while [[ $raw == *--* ]]; do raw=${raw//--/-}; done
  raw=${raw#-}
  raw=${raw%-}
  print -r -- ${raw:l}
}

# The project of the currently running interval, if any.
punch_active_project() {
  local json
  json=$(timew export now 2>/dev/null) || return 1
  # An interval is active only while it has no end timestamp.
  print -r -- $json | jq -re 'map(select(has("end") | not)) | .[0].tags[0] // empty' 2>/dev/null
}

punch_is_tracking() {
  local json
  json=$(timew export now 2>/dev/null) || return 1
  print -r -- $json | jq -e 'map(select(has("end") | not)) | length > 0' >/dev/null 2>&1
}

# --- commands ---------------------------------------------------------------

punch_cmd_in() {
  local project=$1
  shift 2>/dev/null

  if [[ -z $project ]]; then
    project=$(punch_project_for $PWD) || {
      print -u2 "punch: no project for ${PWD/#$HOME/~}"
      print -u2 "    name it with: punch init <name>    or: punch in <name>"
      return 1
    }
  else
    project=$(punch_slug $project)
  fi

  local current
  current=$(punch_active_project)
  if [[ $current == $project ]]; then
    print "punch: already in ${(%):-%B}$project${(%):-%b} ($(punch_elapsed))"
    return 0
  fi

  timew start $project "$@" >/dev/null || return 1

  if [[ -n $current ]]; then
    print "punch: $current → ${(%):-%B}$project${(%):-%b}"
  else
    print "punch: in ${(%):-%B}$project${(%):-%b}"
  fi
}

punch_cmd_out() {
  punch_is_tracking || { print "punch: not clocked in"; return 0; }
  local project elapsed
  project=$(punch_active_project)
  elapsed=$(punch_elapsed)

  # timewarrior refuses a zero-length interval. Starting and stopping within
  # the same second is a misfire, not work, so drop it rather than erroring.
  if [[ $(punch_elapsed_seconds) -lt 1 ]]; then
    timew cancel >/dev/null 2>&1
    print "punch: discarded ${(%):-%B}$project${(%):-%b} (nothing tracked)"
    return 0
  fi

  timew stop >/dev/null || return 1
  print "punch: out of ${(%):-%B}$project${(%):-%b} after $elapsed"
}

# Seconds elapsed in the active interval, or nothing if none is running.
punch_elapsed_seconds() {
  local start_iso
  start_iso=$(timew export now 2>/dev/null \
    | jq -re 'map(select(has("end") | not)) | .[0].start // empty' 2>/dev/null) || return 1
  [[ -n $start_iso ]] || return 1

  local start_epoch
  # timewarrior stamps UTC as YYYYMMDDTHHMMSSZ.
  start_epoch=$(TZ=UTC date -j -f '%Y%m%dT%H%M%SZ' $start_iso '+%s' 2>/dev/null) || return 1

  local secs=$(( $(date '+%s') - start_epoch ))
  (( secs < 0 )) && secs=0
  print -r -- $secs
}

# Seconds as decimal hours, fixed to two places so report columns line up.
punch_hours() {
  local -F 2 h=$(( $1 / 3600.0 ))
  print -r -- $h
}

# The hourly rate for a tag, or nothing. Two lookups: punch_rate is keyed by
# the tag itself, which is the only form that works for names that cannot be
# shell identifiers; PUNCH_RATE_<NAME> stays supported for ASCII names.
punch_rate_for() {
  local tag=$1
  local rate=${punch_rate[$tag]}
  if [[ -z $rate ]]; then
    local suffix=${${tag:u}//[^A-Z0-9]/_}
    # A suffix of nothing but underscores means the name was entirely
    # non-ASCII, and every such project would read the same variable.
    [[ $suffix == *[A-Z0-9]* ]] && rate=${(P)${:-PUNCH_RATE_$suffix}}
  fi
  print -r -- $rate
}

# One report row, padded by display width rather than byte count. printf pads
# by bytes, so a CJK name -- three bytes per two columns -- would drag every
# column after it out of line.
punch_row() {
  local label=${1-} width=24
  local pad=$(( width - ${(m)#label} ))
  (( pad < 1 )) && pad=1
  local line="${label}${(l:$pad:: :)}"
  # Quoted: an unquoted empty argument is dropped from the list entirely,
  # sliding every later column one place to the left.
  line+=$(printf '%8s %8s %10s' "${2-}" "${3-}" "${4-}")
  # Trailing blanks are just noise in a terminal, and they break copy-paste.
  print -r -- "${line%%[[:space:]]##}"
}

# Human-readable duration of the active interval.
punch_elapsed() {
  local secs
  secs=$(punch_elapsed_seconds) || return 1
  printf '%d:%02d' $(( secs / 3600 )) $(( (secs % 3600) / 60 ))
}

# One-line state, used by the prompt, the window title and tmux.
punch_cmd_status() {
  local format=${1:-plain}
  local project
  project=$(punch_active_project)

  if [[ -z $project ]]; then
    case $format in
      plain) print "not tracking" ;;
      short) print "⏸" ;;
      *)     print "" ;;
    esac
    return 1
  fi

  local elapsed
  elapsed=$(punch_elapsed)
  case $format in
    short) print "⏱ $project $elapsed" ;;
    *)     print "tracking $project ($elapsed)" ;;
  esac
  return 0
}

# Everything the prompt needs, tab-separated, in one call: the project this
# directory belongs to, the project being tracked, and how long for. The shell
# integration runs on every prompt, so this exists to keep that to one process.
punch_cmd_prompt_state() {
  local project active elapsed
  project=$(punch_project_for $PWD)
  active=$(punch_active_project)
  [[ -n $active ]] && elapsed=$(punch_elapsed)
  print -r -- "${project}"$'\t'"${active}"$'\t'"${elapsed}"
}

# Status-bar text for tmux, as "<state>|<text>". Unlike the shell hint, this
# has no directory context to compare against -- tmux asks globally, on its own
# refresh clock -- so it reports the clock itself rather than whether it
# matches where you are.
#
# The state prefix lets the tmux format pick a colour from the same call
# instead of running a second one on every refresh.
punch_cmd_tmux_status() {
  (( PUNCH_TMUX_ENABLED )) || return 0
  local project
  project=$(punch_active_project)
  if [[ -n $project ]]; then
    print -r -- "in|${project} $(punch_elapsed)"
  else
    print -r -- "out|out"
  fi
}

# Seconds since the last keyboard or mouse event, from the HID subsystem.
# Needs no permissions and no extra software.
punch_idle_seconds() {
  local ns
  ns=$(ioreg -c IOHIDSystem 2>/dev/null \
    | awk '/HIDIdleTime/ { gsub(/[^0-9]/, "", $NF); print $NF; exit }')
  [[ -n $ns ]] || return 1
  print -r -- $(( ns / 1000000000 ))
}

# Close out an interval that outlived the person working on it.
#
# The whole point is the backdating: stopping *now* after fifteen idle minutes
# would still bill those fifteen minutes. The interval has to end where the
# activity ended, which is idle_seconds ago.
#
# Two things can trigger it. Idleness is the common one. The max-hours cap
# catches the case idleness cannot: a machine left running overnight, where by
# morning the "last activity" is hours of sleep old and the interval has to be
# treated as a forgotten punch-out rather than a very long day.
punch_cmd_idle_check() {
  (( PUNCH_IDLE_ENABLED )) || return 0
  punch_is_tracking || return 0

  local elapsed idle
  elapsed=$(punch_elapsed_seconds) || return 0
  idle=$(punch_idle_seconds) || return 0

  local idle_limit=$(( PUNCH_IDLE_MINUTES * 60 ))
  local max_limit=$(( PUNCH_MAX_INTERVAL_HOURS * 3600 ))
  local reason="" back=0

  if (( idle >= idle_limit )); then
    reason="idle for $(( idle / 60 ))m"
    back=$idle
  elif (( elapsed >= max_limit )); then
    reason="ran past ${PUNCH_MAX_INTERVAL_HOURS}h"
    back=$idle
  else
    return 0
  fi

  local project
  project=$(punch_active_project)

  # Idle for longer than the interval itself means nothing real happened in
  # it -- clocked in, then walked away. Recording a sliver is worse than
  # recording nothing, so drop it.
  if (( back >= elapsed )); then
    timew cancel >/dev/null 2>&1 || return 1
    print -r -- "punch: discarded ${project} (${reason}, nothing worked on)"
    return 0
  fi

  local end_stamp
  end_stamp=$(date -v-${back}S '+%Y-%m-%dT%H:%M:%S') || return 1

  timew stop $end_stamp >/dev/null 2>&1 || return 1

  print -r -- "punch: auto-out ${project} at ${end_stamp} (${reason})"
}

# Write a .punch-card marker so this tree stops depending on git remotes.
punch_cmd_init() {
  local name=${1:-${PWD:t}}
  name=$(punch_slug $name)
  local marker=$PWD/.punch-card

  if [[ -e $marker ]]; then
    print -u2 "punch: $marker already exists"
    return 1
  fi

  print -r -- $name > $marker
  print "punch: ${PWD/#$HOME/~} → ${(%):-%B}$name${(%):-%b}"
  print "punch: consider adding .punch-card to your global gitignore"
}

punch_cmd_bill() {
  local month="" project="" format="table" detail=0

  while (( $# )); do
    case $1 in
      --month|-m)   month=$2; shift 2 ;;
      --project|-p) project=$(punch_slug $2); shift 2 ;;
      --csv)        format="csv"; shift ;;
      --markdown)   format="markdown"; shift ;;
      --detail|-d)  detail=1; shift ;;
      *)            print -u2 "punch bill: unknown option $1"; return 1 ;;
    esac
  done

  # Default to the current month, and accept either `8` or `2026-08`.
  [[ -z $month ]] && month=$(date '+%Y-%m')
  if [[ $month == <-> && ${#month} -le 2 ]]; then
    month=$(printf '%s-%02d' $(date '+%Y') $month)
  fi
  if [[ $month != <->-<-> ]]; then
    print -u2 "punch bill: --month expects YYYY-MM or a month number"
    return 1
  fi

  local range_start=${month}-01
  local range_end
  range_end=$(date -j -v+1m -f '%Y-%m-%d' $range_start '+%Y-%m-%d' 2>/dev/null) || {
    print -u2 "punch bill: invalid month $month"
    return 1
  }

  local json
  json=$(timew export $range_start - $range_end 2>/dev/null) || {
    print -u2 "punch bill: could not read timewarrior data"
    return 1
  }

  # Aggregate seconds per project, then price them in the shell where the
  # per-project rates from the config file are in scope.
  local -A seconds
  local line tag secs
  while IFS=$'\t' read -r tag secs; do
    [[ -n $tag ]] || continue
    [[ -n $project && $tag != $project ]] && continue
    seconds[$tag]=$secs
  done < <(print -r -- $json | jq -r '
    map(select(has("end")))
    | map({
        tag: (.tags[0] // "untagged"),
        secs: ((.end | strptime("%Y%m%dT%H%M%SZ") | mktime)
             - (.start | strptime("%Y%m%dT%H%M%SZ") | mktime))
      })
    | group_by(.tag)
    | map([.[0].tag, (map(.secs) | add)])
    | .[] | @tsv
  ' 2>/dev/null)

  if (( ${#seconds} == 0 )); then
    print "punch: no completed intervals in $month${project:+ for $project}"
    return 0
  fi

  # The document's title belongs above everything, including the detail table
  # that follows -- this output gets handed to a client as-is.
  [[ $format == markdown ]] && print "# Time report — $month${project:+ — $project}\n"

  # Detail is what gets attached to an invoice: every interval, not a month's
  # total. Printed before the summary so the summary stays the last thing read.
  if (( detail )); then
    local -a lines
    lines=("${(@f)$(print -r -- $json | jq -r --arg only "$project" '
      map(select(has("end")))
      | map(select($only == "" or (.tags[0] // "untagged") == $only))
      | sort_by(.start)
      | .[]
      | [ (.start | strptime("%Y%m%dT%H%M%SZ") | mktime),
          (.end   | strptime("%Y%m%dT%H%M%SZ") | mktime),
          (.tags[0] // "untagged") ]
      | @tsv
    ' 2>/dev/null)}")

    if (( ${#lines} )); then
      case $format in
        markdown) print "## Detail\n"
                  print "| Date | From | To | Hours | Project |"
                  print "| --- | --- | --- | ---: | --- |" ;;
        csv)      print "date,from,to,hours,project" ;;
        *)        printf '%-12s %-13s %7s  %s\n' DATE WHEN HOURS PROJECT ;;
      esac

      local l
      for l in $lines; do
        [[ -n $l ]] || continue
        local -a f=(${(ps:\t:)l})
        # jq emits UTC epochs; render them in local time, as they were worked.
        local day=$(date -r ${f[1]} '+%Y-%m-%d')
        local from=$(date -r ${f[1]} '+%H:%M')
        local to=$(date -r ${f[2]} '+%H:%M')
        local h=$(punch_hours $(( f[2] - f[1] )))
        case $format in
          markdown) print -r -- "| $day | $from | $to | $h | ${f[3]} |" ;;
          csv)      print -r -- "$day,$from,$to,$h,${f[3]}" ;;
          *)        printf '%-12s %-13s %7s  %s\n' "$day" "$from-$to" "$h" "${f[3]}" ;;
        esac
      done
      print
    fi
  fi

  # Split by whether a rate exists. A rate is what makes work billable, so
  # nothing extra has to be remembered at clock-in time to classify it.
  local -a billable internal
  local billed_secs=0 internal_secs=0 total_amount=0
  for tag in ${(k)seconds}; do
    local s=${seconds[$tag]}
    local rate=$(punch_rate_for $tag)
    if [[ -n $rate ]]; then
      # Round to the nearest whole unit of currency, integer-only.
      local amount=$(( (s * rate + 1800) / 3600 ))
      (( total_amount += amount ))
      (( billed_secs += s ))
      billable+=("${s}"$'\t'"${tag}"$'\t'"${rate}"$'\t'"${amount}")
    else
      (( internal_secs += s ))
      internal+=("${s}"$'\t'"${tag}")
    fi
  done

  # Longest hours first, so the biggest slice of the month reads first.
  billable=(${(On)billable})
  internal=(${(On)internal})

  local total_secs=$(( billed_secs + internal_secs ))

  case $format in
    csv)
      print "project,hours,rate,amount,currency,billable"
      local row
      for row in $billable; do
        local -a f=(${(ps:\t:)row})
        print -r -- "${f[2]},$(punch_hours ${f[1]}),${f[3]},${f[4]},$PUNCH_CURRENCY,yes"
      done
      for row in $internal; do
        local -a f=(${(ps:\t:)row})
        print -r -- "${f[2]},$(punch_hours ${f[1]}),,,$PUNCH_CURRENCY,no"
      done
      ;;
    markdown)
      local row
      if (( ${#billable} )); then
        print
        print "## Billable"
        print
        print "| Project | Hours | Rate | Amount |"
        print "| --- | ---: | ---: | ---: |"
        for row in $billable; do
          local -a f=(${(ps:\t:)row})
          print -r -- "| ${f[2]} | $(punch_hours ${f[1]}) | ${f[3]} | ${f[4]} |"
        done
        print -r -- "| **Subtotal** | **$(punch_hours $billed_secs)** | | **${total_amount}** |"
      fi
      if (( ${#internal} )); then
        print
        print "## Internal"
        print
        print "| Project | Hours |"
        print "| --- | ---: |"
        for row in $internal; do
          local -a f=(${(ps:\t:)row})
          print -r -- "| ${f[2]} | $(punch_hours ${f[1]}) |"
        done
        print -r -- "| **Subtotal** | **$(punch_hours $internal_secs)** |"
      fi
      print
      print -r -- "**Total: $(punch_hours $total_secs) h — ${total_amount} ${PUNCH_CURRENCY}**"
      ;;
    *)
      local row
      if (( ${#billable} )); then
        punch_row BILLABLE HOURS RATE AMOUNT
        for row in $billable; do
          local -a f=(${(ps:\t:)row})
          punch_row ${f[2]} $(punch_hours ${f[1]}) ${f[3]} ${f[4]}
        done
        punch_row '' "$(punch_hours $billed_secs)" '' "$total_amount"
      fi
      if (( ${#internal} )); then
        (( ${#billable} )) && print
        punch_row INTERNAL HOURS
        for row in $internal; do
          local -a f=(${(ps:\t:)row})
          punch_row ${f[2]} $(punch_hours ${f[1]})
        done
        punch_row '' "$(punch_hours $internal_secs)"
      fi
      print
      punch_row TOTAL "$(punch_hours $total_secs)" '' "$total_amount"
      (( ${#internal} )) && print "\n(internal work has no rate set in $PUNCH_RATES_FILE)"
      ;;
  esac
}

punch_cmd_help() {
  cat <<'EOF'
punch — timewarrior, with projects inferred from the filesystem.

  punch in [project] [tags...]  clock in (project defaults to $PWD's)
  punch out                     clock out
  punch status [short]          one-line state, for prompts and status bars
  punch init [name]             mark $PWD as a project (.punch-card)
  punch bill [--month YYYY-MM] [--project X] [--detail] [--csv|--markdown]
                                billable and internal hours, and amounts

`start` and `stop` are synonyms for `in` and `out`.

Anything else is passed straight to timewarrior:

  punch summary :week           timewarrior's own reports
  punch move @2 09:00           backfilling and corrections
  punch @3 tag billable

Config: ~/.config/punch/config
EOF
}

# --- dispatch ---------------------------------------------------------------

if ! (( $+commands[timew] )); then
  print -u2 "punch: timewarrior is not installed (brew install timewarrior)"
  exit 127
fi
if ! (( $+commands[jq] )); then
  print -u2 "punch: jq is not installed (brew install jq)"
  exit 127
fi

case ${1:-status} in
  in|i|start)      shift; punch_cmd_in "$@" ;;
  out|o|stop)      shift; punch_cmd_out "$@" ;;
  status)          shift; punch_cmd_status "$@" ;;
  init)            shift; punch_cmd_init "$@" ;;
  bill)            shift; punch_cmd_bill "$@" ;;
  project)         shift; punch_project_for ${1:-$PWD} ;;
  prompt-state)    shift; punch_cmd_prompt_state ;;
  tmux-status)     shift; punch_cmd_tmux_status ;;
  idle-check)      shift; punch_cmd_idle_check ;;
  help|--help|-h)  punch_cmd_help ;;
  *)               timew "$@" ;;
esac

#!/bin/bash
# Install the casks and mas apps from Brewfile
# This runs last, and again whenever Brewfile changes
# Brewfile hash: {{ include "dot_config/homebrew/Brewfile" | sha256sum }}

{{- if eq .chezmoi.os "darwin" }}
echo "Installing Homebrew apps..."

{{ template "load-brew.sh" }}

BREWFILE="${XDG_CONFIG_HOME:-$HOME/.config}/homebrew/Brewfile"

# Script 02 already installed the formulae, so this mostly installs casks and
# mas apps. A failure here fails the script, so the next `chezmoi apply` tries
# again. It is safe to stop this step with Ctrl+C for the same reason.
echo "Running: brew bundle install --file=$BREWFILE --no-upgrade --verbose"
if ! brew bundle install --file="$BREWFILE" --no-upgrade --verbose; then
    echo "Some entries did not install. To see which ones:"
    echo "  brew bundle check --file=$BREWFILE --verbose"
    echo "The next \`chezmoi apply\` will try again."
    exit 1
fi

echo "✓ Homebrew apps installed"
{{- else }}
echo "Skipping Homebrew apps (not macOS)"
{{- end }}

 # Ghostty Terminal Configuration

# ============================================================================
# macOS-Specific Settings
# ============================================================================

# Option key as Alt for terminal applications (essential for tmux, vim, etc.)
macos-option-as-alt = true

# Hide titlebar while keeping native window borders and rounded corners
# macos-titlebar-style = hidden

# ============================================================================
# Terminal Compatibility
# ============================================================================

# Use Ghostty's terminfo for best compatibility
term = xterm-ghostty

# ============================================================================
# Window Settings
# ============================================================================

# Remember window size and position
window-save-state = always

# Vertical sync (prevents kernel panics on macOS 14.4+)
window-vsync = true

# Close a split or tab without asking
confirm-close-surface = false

# No size overlay while dragging a window edge
resize-overlay = never

# Get the pointer out of the way
mouse-hide-while-typing = true

# ============================================================================
# Font Settings
# ============================================================================

# Thicken font rendering (macOS-only feature)
font-thicken = true

font-family = "SF Mono Regular"
font-size = 14

# Disable programming ligatures (-->, >=, != etc.)
font-feature = -calt

# ============================================================================
# Visual Effects
# ============================================================================

# Background transparency (disabled in native fullscreen)
# background-opacity = 0.7

# Background blur effect
# background-blur = 16

unfocused-split-opacity = 0.85

# ============================================================================
# Theme
# ============================================================================

# Use `ghostty +list-themes` to see all available themes
# theme = catppuccin-mocha
theme = Catppuccin Frappe

# ============================================================================
# Notifications
# ============================================================================

# Notify when a command finishes, for the ones that take long enough that you
# have switched away. Needs shell integration, which Ghostty detects for zsh.
notify-on-command-finish = always
notify-on-command-finish-after = 30s

# ============================================================================
# Keybindings
# ============================================================================

# No Quick Terminal binding. A global: keybind takes the key from every other
# app, and cmd+` cycles windows in the active app.

# Config reload: Cmd + Shift + ,
# Open config: Cmd + ,

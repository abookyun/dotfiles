#!/bin/bash
# Install Homebrew packages from Brewfile
# This runs once after applying dotfiles

{{- if eq .chezmoi.os "darwin" }}
set -e

echo "Installing Homebrew packages..."

# Put brew on PATH if it is installed but the calling shell does not have it
load_brew() {
    command -v brew &> /dev/null && return
    if [ -x /opt/homebrew/bin/brew ]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [ -x /usr/local/bin/brew ]; then
        eval "$(/usr/local/bin/brew shellenv)"
    fi
}

load_brew

# Check if Homebrew is installed
if ! command -v brew &> /dev/null; then
    echo "Homebrew is not installed"
    echo "Installing Homebrew for you."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

    load_brew
    if ! command -v brew &> /dev/null; then
        echo "Error: Homebrew installed but brew was not found"
        exit 1
    fi

    echo "Homebrew installed!"
fi

# Check if Brewfile exists
BREWFILE="${XDG_CONFIG_HOME:-$HOME/.config}/homebrew/Brewfile"
if [ ! -f "$BREWFILE" ]; then
    echo "Error: Brewfile not found at $BREWFILE"
    exit 1
fi

# Install only taps and formulae here. The dotfiles and the asdf script need
# them, and they download fast. Casks and mas apps can be slow, so script 05
# installs them after everything else.
# A failed entry here should not stop the language runtimes from installing.
echo "Running: brew bundle for the taps and formulae in $BREWFILE"
if grep -E '^(tap|brew) ' "$BREWFILE" | brew bundle install --file=- --verbose; then
    echo "✓ Homebrew formulae installed"
else
    echo "Some entries did not install. To see which ones:"
    echo "  brew bundle check --file=$BREWFILE --verbose"
    echo "Going on to the next step."
fi

# From the zsh-completions caveat: compinit warns about "insecure
# directories" while the Homebrew installer leaves share group writable.
chmod go-w "$(brew --prefix)/share"
chmod -R go-w "$(brew --prefix)/share/zsh"
{{- else }}
echo "Skipping Homebrew installation (not macOS)"
{{- end }}

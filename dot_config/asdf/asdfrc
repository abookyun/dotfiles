# asdf configuration.
# Keys and defaults: https://asdf-vm.com/manage/configuration.html
#
# This file is key-value, not shell. asdf parses it and ignores anything it
# does not recognise, so an `export` line here would fail without an error.
# The asdf environment variables live in zsh/asdf.zsh.

# Read .ruby-version, .nvmrc and similar files from other version managers.
# .tool-versions still wins where it names a tool, so this only adds a fallback
# for projects that do not carry one. Needs plugin support to take effect.
legacy_version_file = yes
